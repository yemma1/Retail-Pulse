# ==============================================================================
# Online Retail Sales Analytics - Environment Variables
# ==============================================================================

# Flask Settings
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
SECRET_KEY=replace-with-a-secure-random-key-in-production

# Oracle Database Configuration
# Set these variables to connect to an enterprise Oracle Database (19c/21c/23c/Autonomous DB)
# If left blank, the application automatically runs using the local embedded SQLite engine.
ORACLE_USER=retail_admin
ORACLE_PASSWORD=YourSecurePassword123!
ORACLE_DSN=localhost:1521/XEPDB1

# Oracle Autonomous / Cloud Wallet Configuration (Optional)
# ORACLE_WALLET_DIR=/path/to/wallet
# ORACLE_WALLET_PASSWORD=WalletPassword123!
